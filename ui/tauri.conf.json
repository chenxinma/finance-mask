{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "财务文件智能脱敏",
  "version": "0.1.0",
  "identifier": "com.chenxinma.finance-mask",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "财务文件智能脱敏",
        "width": 540,
        "height": 960,
        "minWidth": 432,
        "minHeight": 768
      }
    ],
    "security": {
